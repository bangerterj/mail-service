# Required
# "configurationSet" is optional — add it per app only once the SES configuration
# set of that name actually exists, or every send fails.
APPS='{"key_live_replace_me":{"appId":"example","from":"noreply@example.com","fromName":"Example","templates":["welcome","password-reset","verify-email"]}}'

# Fixed: SES identities and production access live in us-east-1 (AWS_HANDOFF.md).
AWS_REGION=us-east-1
MAIL_AWS_ACCESS_KEY_ID=
MAIL_AWS_SECRET_ACCESS_KEY=

# Optional
EMAIL_PROVIDER=console
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SES_WEBHOOK_SECRET=
